        <mxCell id="n2" value="Strategy (RNF02): sem if/switch por categoria; regra trocada em tempo de execução (RF07)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fontSize=11;fillColor=#fffbe6;strokeColor=#999999;" vertex="1" parent="1">
