        <!-- ===== NOTAS ===== -->
        <mxCell id="n1" value="Observer (RNF01): o Lote só conhece a interface. Novo tipo de interessado = classe nova." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fontSize=11;fillColor=#fffbe6;strokeColor=#999999;" vertex="1" parent="1">
